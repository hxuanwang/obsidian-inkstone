{
  "name": "inkstone-obsidian",
  "version": "0.4.0",
  "private": true,
  "description": "A Pencil-first handwriting workspace for Obsidian",
  "scripts": {
    "build": "npm run prepare:ocr && tsc --noEmit && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "demo": "npm run prepare:ocr && node esbuild.config.mjs --demo && node scripts/serve.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nspell": "^2.1.6",
    "dictionary-en": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "nspell": "^2.1.5",
    "tesseract.js": "6.0.1"
  }
}
